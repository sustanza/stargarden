---
import { Image } from "astro:assets";
import hero from "../assets/landing-hero.svg";
---

<section class="hero py-12 lg:py-20">
  <div
    class="hero-content container mx-auto flex flex-col-reverse items-center gap-8 px-4 lg:flex-row"
  >
    <!-- Text -->
    <div class="flex flex-col justify-center text-center lg:w-1/2 lg:text-left">
      <h1 class="text-4xl leading-tight font-bold md:text-5xl">
        Stargarden Theme for Astro
      </h1>
      <h2 class="text-secondary mt-3 text-xl font-semibold md:text-2xl">
        A modern, content-focused starter theme for Astro, styled with Tailwind
        CSS and daisyUI.
      </h2>
      <p class="mx-auto mt-4 max-w-[600px] text-base md:text-lg lg:mx-0">
        Use this theme as a starting point for your own blog, documentation, or
        content site. All content and pages are for demonstration—replace them
        to make it your own!
      </p>
      <div class="mt-6">
        <a href="/posts/" class="btn btn-primary btn-lg">View Posts</a>
      </div>
    </div>

    <!-- Image -->
    <div class="lg:w-1/2">
      <Image
        src={hero}
        alt="StarGarden hero illustration"
        class="w-full rounded-xl object-cover shadow-md"
      />
    </div>
  </div>
</section>
