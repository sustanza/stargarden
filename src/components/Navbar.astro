---
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";
import Search from "astro-pagefind/components/Search";
import MagnifyingGlassIcon from "../assets/icons/magnifying-glass.svg";
import Bars3Icon from "../assets/icons/bars-3.svg";
import XMarkIcon from "../assets/icons/x-mark.svg";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<header class="bg-base-100 shadow-sm">
  <!-- ********** Mobile (< lg): drawer & navbar ********** -->
  <div class="drawer lg:hidden">
    <!-- Hidden checkbox toggles the drawer -->
    <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

    <div class="drawer-content flex flex-col">
      <nav class="navbar bg-base-100 relative w-full px-2 lg:px-4">
        <!-- Hamburger icon on the left -->
        <div class="flex-none">
          <label
            for="nav-drawer"
            aria-label="Open sidebar"
            class="btn btn-ghost btn-square"
          >
            <Bars3Icon class="h-5 w-5" />
          </label>
        </div>

        <!-- Logo centered absolutely -->
        <a
          href="/"
          class="absolute left-1/2 flex -translate-x-1/2 items-center"
        >
          <Image src={logo} alt="Stargarden logo" class="h-[4.5rem] w-auto" />
        </a>
        <div class="ml-auto flex-none">
          <button
            aria-label="Open search"
            class="btn btn-ghost btn-square"
            onclick="document.getElementById('search_modal')?.showModal()"
          >
            <!-- Magnifying glass icon -->
            <MagnifyingGlassIcon class="h-5 w-5" />
          </button>
          <ThemeToggle />
        </div>
      </nav>
      <dialog id="search_modal" class="modal">
        <div
          class="modal-box relative flex h-[90vh] w-11/12 max-w-2xl flex-col overflow-y-auto"
        >
          <form method="dialog">
            <button
              class="btn btn-sm btn-circle btn-ghost absolute top-2 right-2"
              aria-label="Close search"
            >
              <XMarkIcon class="h-5 w-5" />
            </button>
          </form>
          <div class="relative">
            <Search
              id="mobile-search"
              className="pagefind-ui mt-8 mb-2 w-full"
              uiOptions={{ showImages: false }}
            />
          </div>
        </div>
      </dialog>
    </div>

    <!-- Slide‑out sidebar -->
    <div class="drawer-side">
      <label for="nav-drawer" class="drawer-overlay" aria-label="Close sidebar"
      ></label>
      <ul class="menu bg-base-100 min-h-full w-80 p-4">
        <li>
          <a href="/posts/" class="text-xl font-bold normal-case">Blog</a>
        </li>
        <li>
          <a href="/about/" class="text-xl font-bold normal-case">About</a>
        </li>
      </ul>
    </div>
  </div>

  <!-- ********** Desktop (≥ lg): standard navbar ********** -->
  <nav
    class="navbar bg-base-100 hidden w-full lg:flex"
    style="--navbar-padding:0;"
  >
    <div class="navbar-start">
      <a href="/" class="flex items-center gap-2">
        <Image src={logo} alt="Stargarden logo" class="h-[4.5rem] w-auto" />
        <span class="text-xl font-bold">Stargarden</span>
      </a>
    </div>
    <div class="navbar-end">
      <ul class="menu menu-horizontal gap-2">
        <li>
          <a href="/posts/" class="text-lg font-bold normal-case">Posts</a>
        </li>
        <li>
          <a href="/about/" class="text-lg font-bold normal-case">About</a>
        </li>
      </ul>

      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{ showImages: false }}
      />
      <ThemeToggle />
    </div>
  </nav>
</header>
